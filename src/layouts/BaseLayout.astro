---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, homePath, LINKEDIN_URL, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Paths of this same page in each language. Omit when the page exists in one language only. */
  alternates?: Partial<Record<Lang, string>>;
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'en',
  alternates,
  ogImage = '/og-default.png',
} = Astro.props;

const t = ui[lang];
const site = Astro.site ?? new URL('https://pechgroup.com');
const canonicalURL = new URL(Astro.url.pathname, site).href;
const fullTitle = title.includes('PECH Group') ? title : `${title} | PECH Group`;
const ogImageURL = new URL(ogImage, site).href;
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
// Language toggle target: the translated page when there is one, else that language's home.
const switchHref = alternates?.[otherLang] ?? homePath[otherLang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://pechgroup.com/#org',
      name: 'PECH Group LLC',
      alternateName: 'PECH Group',
      url: 'https://pechgroup.com/',
      logo: 'https://pechgroup.com/apple-touch-icon.png',
      description:
        'Texas holding company overseeing five US–Mexico cross-border ventures: Wisdom Digital Logistics, Lateral Fulfillment, Kotickcold, Echo-XB and PECH Labs.',
      address: { '@type': 'PostalAddress', addressRegion: 'TX', addressCountry: 'US' },
      areaServed: ['US', 'MX'],
      slogan: 'Think Beyond Borders',
      subOrganization: ['Wisdom Digital Logistics', 'Lateral Fulfillment', 'Kotickcold', 'Echo-XB', 'PECH Labs'].map(
        (name) => ({ '@type': 'Organization', name }),
      ),
    },
    {
      '@type': 'Person',
      '@id': 'https://pechgroup.com/#ed-pereda',
      name: 'Ed Pereda',
      jobTitle: 'Chairman & Lead Investor',
      worksFor: { '@id': 'https://pechgroup.com/#org' },
      knowsLanguage: ['en', 'es'],
      sameAs: [LINKEDIN_URL],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0D0D0D" />

    <!-- Primary SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternates && Object.entries(alternates).map(([l, path]) => (
      <link rel="alternate" hreflang={l} href={new URL(path, site).href} />
    ))}
    {alternates?.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, site).href} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PECH Group — North American Cross-Border Platform Builder" />
    <meta property="og:site_name" content="PECH Group" />
    <meta property="og:locale" content={t.locale} />
    {alternates?.[otherLang] && <meta property="og:locale:alternate" content={ui[otherLang].locale} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="PECH Group — North American Cross-Border Platform Builder" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts: preconnect + non-blocking stylesheet (was a render-blocking CSS @import) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" />
    <link rel="preload" href="/fonts/Fitiya-Bold.otf" as="font" type="font/otf" crossorigin />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">{t.skip}</a>
    <Header lang={lang} switchHref={switchHref} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- WhatsApp button removed: it pointed to a placeholder number (wa.me/1XXXXXXXXXX)
         and its CSS class didn't match, so it rendered unstyled. [TODO: Ed — WhatsApp number] -->
  </body>
</html>
