---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pech Group"
  description="Pech Group — Divergent Strategies. Boutique executive advisory firm bridging the US and Mexico. Fractional leadership, nearshoring strategy, and applied AI ventures."
>

  <!-- HERO — dark bg, white text, teal accent -->
  <section class="hero bg-darker sec">
    <div class="wrap">
      <p class="lbl">Executive Advisory · Bay Area · Texas · Mexico</p>
      <h1>Divergent<br/><span class="teal">Strategies.</span></h1>
      <p class="hero__sub">
        We bring Fortune-500-caliber executive leadership to growth-stage and
        mid-market companies on a fractional basis — and we operate across the
        US–Mexico corridor like no one else.
      </p>
      <div class="hero__btns">
        <a href="/contact" class="btn btn-teal">Explore a Partnership</a>
        <a href="/services" class="btn btn-ghost">Our Services</a>
      </div>

      <div class="hero__stats">
        <div class="stat">
          <span class="stat__n">12+</span>
          <span class="stat__l">Years leading binational operations</span>
        </div>
        <div class="stat__div" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat__n">3</span>
          <span class="stat__l">Countries of active footprint</span>
        </div>
        <div class="stat__div" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat__n">EN/ES</span>
          <span class="stat__l">Bilingual & bicultural</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES — light bg, dark text -->
  <section class="bg-light sec">
    <div class="wrap">
      <p class="lbl">What We Do</p>
      <h2>Five practices. One perspective.</h2>
      <p class="intro-p">We embed at the leadership level — delivering strategy, execution discipline, and operational continuity across borders.</p>

      <div class="svc-grid">
        <a href="/services#fractional" class="svc-card">
          <div class="icon-chip">
            <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
          </div>
          <h3>Fractional Executive Leadership</h3>
          <p>Interim CEO/President/MD engagements for companies that need seasoned executive horsepower without a full-time hire.</p>
          <span class="svc-link">Learn more →</span>
        </a>

        <a href="/services#nearshoring" class="svc-card">
          <div class="icon-chip">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          </div>
          <h3>US–Mexico Trade & Nearshoring</h3>
          <p>Strategic advisory for companies evaluating or executing nearshoring — market entry, site strategy, binational org design.</p>
          <span class="svc-link">Learn more →</span>
        </a>

        <a href="/services#startup" class="svc-card">
          <div class="icon-chip">
            <svg viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h3>Startup & Venture Advisory</h3>
          <p>Go-to-market, org design, fundraising readiness, and operating cadence for founders ready to scale.</p>
          <span class="svc-link">Learn more →</span>
        </a>

        <a href="/services#ecommerce" class="svc-card">
          <div class="icon-chip">
            <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
          </div>
          <h3>E-commerce & Cross-Border Commerce</h3>
          <p>Channel strategy, market expansion, and operating model design for brands expanding into Mexico and LATAM.</p>
          <span class="svc-link">Learn more →</span>
        </a>

        <a href="/services#ai" class="svc-card svc-card--dark">
          <div class="icon-chip">
            <svg viewBox="0 0 24 24"><path d="M12 2a2 2 0 012 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 017 7h1a1 1 0 010 2h-1v1a2 2 0 01-2 2H5a2 2 0 01-2-2v-1H2a1 1 0 010-2h1a7 7 0 017-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 012-2zM7 14a5 5 0 0010 0H7z"/></svg>
          </div>
          <h3>Technology & AI Ventures</h3>
          <p>Hands-on experience launching AI-native products. We run our firm on autonomous agents first, then productize what works.</p>
          <span class="svc-link teal">Learn more →</span>
        </a>
      </div>

      <div class="center-cta">
        <a href="/services" class="btn btn-ghost-dark">View All Services</a>
      </div>
    </div>
  </section>

  <!-- PECH LABS — darkest bg, white + teal -->
  <section class="bg-darker sec">
    <div class="wrap labs">
      <div class="labs__text">
        <p class="lbl">Innovation Arm</p>
        <div class="teal-bar"></div>
        <h2>PECH Labs</h2>
        <p>
          Our applied-AI venture studio. We don't sell AI hype — we build
          and operate autonomous AI agents inside our own firm first, then
          productize what works. We are customer zero.
        </p>
        <p style="margin-top:0.75rem;">
          Flagship offering: <strong class="teal">AI Agents as a Service</strong> — autonomous agents
          that handle executive workflows: research, reporting,
          back-office orchestration, and briefing automation.
        </p>
        <div class="labs__btns">
          <a href="/innovation" class="btn btn-teal">Explore PECH Labs</a>
          <a href="/contact?ref=labs" class="btn btn-ghost">Request Early Access</a>
        </div>
      </div>

      <div class="labs__nodes" aria-hidden="true">
        <div class="node node--c">
          <svg viewBox="0 0 60 54">
            <polygon points="30,2 58,18 46,52 14,52 2,18"/>
            <line x1="2"  y1="18" x2="58" y2="18"/>
            <line x1="30" y1="2"  x2="14" y2="52"/>
            <line x1="30" y1="2"  x2="46" y2="52"/>
            <line x1="14" y1="52" x2="30" y2="18"/>
            <line x1="46" y1="52" x2="30" y2="18"/>
          </svg>
        </div>
        <div class="node node--t">Research</div>
        <div class="node node--r">Reporting</div>
        <div class="node node--b">Operations</div>
        <div class="node node--l">Briefings</div>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK — white bg, dark text -->
  <section class="bg-white sec">
    <div class="wrap">
      <p class="lbl">Our Model</p>
      <h2>The fractional advantage.</h2>
      <p class="intro-p">Seasoned executive leadership on a monthly retainer plus milestone-based fees. No recruiting lag. No full-time overhead.</p>

      <div class="steps cols-3">
        <div class="step">
          <span class="step__n">01</span>
          <h3>Align on scope</h3>
          <p>We define the engagement charter, objectives, and success metrics together before a single day of work begins.</p>
        </div>
        <div class="step">
          <span class="step__n">02</span>
          <h3>Embed at the leadership level</h3>
          <p>We work inside your company — attending board meetings, leading teams, and driving decisions as a functional executive.</p>
        </div>
        <div class="step">
          <span class="step__n">03</span>
          <h3>Deliver and evolve</h3>
          <p>Monthly retainers plus milestone fees tied to outcomes. We grow with your needs or transition cleanly when the mission is done.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA — dark bg -->
  <section class="bg-dark sec">
    <div class="wrap cta-row">
      <div>
        <h2>Ready to engage?</h2>
        <p>No pitch decks — just a direct conversation about fit.</p>
      </div>
      <a href="/contact" class="btn btn-teal">Start the Conversation</a>
    </div>
  </section>

</BaseLayout>

<style>
/* Accent color helper */
.teal { color:var(--teal); }

/* Hero */
.hero { min-height:90vh; display:flex; align-items:center; }
.hero h1 { margin:0.5rem 0 1.25rem; }
.hero__sub {
  font-size:var(--t3); color:rgba(255,255,255,0.55);
  max-width:52ch; margin-bottom:2rem; line-height:1.8;
}
.hero__btns { display:flex; gap:0.75rem; flex-wrap:wrap; margin-bottom:3.5rem; }

.hero__stats {
  display:flex; align-items:center; gap:2rem;
  padding-top:2.5rem;
  border-top:1px solid rgba(90,191,181,0.15);
  flex-wrap:wrap;
}
.stat__n {
  display:block; font-family:var(--font-h); font-size:1.75rem;
  font-weight:700; color:var(--teal); line-height:1;
}
.stat__l { display:block; font-size:var(--fn); color:rgba(255,255,255,0.4); margin-top:3px; }
.stat__div { width:1px; height:32px; background:rgba(90,191,181,0.15); }

/* Services grid */
.intro-p { max-width:56ch; margin-bottom:2.5rem; }

.svc-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(240px,1fr));
  gap:1px;
  background:var(--gray-1);
  border:1px solid var(--gray-1);
  border-radius:var(--radius);
  overflow:hidden;
  margin-bottom:2rem;
}
.svc-card {
  background:var(--white); padding:1.75rem;
  display:flex; flex-direction:column; gap:0.5rem;
  text-decoration:none; transition:background var(--ease);
}
.svc-card:hover { background:var(--off-white); }
.svc-card h3 { color:var(--dark); }
.svc-card p  { color:var(--gray-3); font-size:var(--fn); }

.svc-card--dark { background:var(--dark-2); }
.svc-card--dark:hover { background:var(--dark-3); }
.svc-card--dark h3 { color:var(--white); }
.svc-card--dark p  { color:rgba(255,255,255,0.5); }

.svc-link {
  display:inline-block; margin-top:auto; padding-top:0.75rem;
  font-family:var(--font-h); font-size:var(--fn);
  letter-spacing:0.06em; color:var(--teal-dim);
}
.svc-link.teal { color:var(--teal); }

.center-cta { text-align:center; }

/* Labs section */
.labs {
  display:grid; grid-template-columns:1fr 1fr;
  gap:4rem; align-items:center;
}
.labs__text { display:flex; flex-direction:column; gap:0.75rem; }
.labs__text h2 { color:var(--white); }
.labs__text p { color:rgba(255,255,255,0.55); }
.labs__btns { display:flex; gap:0.75rem; flex-wrap:wrap; margin-top:0.5rem; }

/* Labs visual */
.labs__nodes {
  position:relative; height:280px;
  display:flex; align-items:center; justify-content:center;
}
.node--c svg {
  width:80px; height:80px;
  stroke:var(--teal); fill:none;
  stroke-width:1.2; stroke-linecap:round; stroke-linejoin:round;
  animation:float 5s ease-in-out infinite;
}
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }

.node {
  position:absolute;
  font-family:var(--font-h); font-size:var(--fn);
  letter-spacing:0.14em; text-transform:uppercase;
  color:var(--teal); background:rgba(90,191,181,0.07);
  border:1px solid rgba(90,191,181,0.18);
  border-radius:3px; padding:0.3rem 0.75rem;
}
.node--t { top:6%; left:50%; transform:translateX(-50%); }
.node--r { top:50%; right:0%; transform:translateY(-50%); }
.node--b { bottom:6%; left:50%; transform:translateX(-50%); }
.node--l { top:50%; left:0%; transform:translateY(-50%); }

/* Steps */
.step { border-top:1px solid var(--gray-1); padding-top:1.5rem; }
.step__n {
  display:block; font-family:var(--font-h);
  font-size:1.5rem; font-weight:700;
  color:var(--teal); opacity:0.25; line-height:1;
  margin-bottom:0.5rem;
}
.step h3 { color:var(--dark); margin-bottom:0.4rem; }
.step p  { font-size:var(--fn); }

/* Bottom CTA */
.cta-row {
  display:flex; align-items:center; justify-content:space-between;
  gap:2rem; flex-wrap:wrap;
}
.cta-row h2 { color:var(--white); margin-bottom:0.25rem; }
.cta-row p  { color:rgba(255,255,255,0.5); max-width:none; }

@media(max-width:860px) {
  .labs { grid-template-columns:1fr; }
  .labs__nodes { display:none; }
  .cta-row { flex-direction:column; text-align:center; }
}
</style>
