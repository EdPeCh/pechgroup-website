---
import BaseLayout from '../layouts/BaseLayout.astro';
const ref = Astro.url.searchParams.get('ref');
const isLabs = ref === 'labs';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Pech Group. We work with founders, boards, and executives across the US and Mexico. No intake forms — just a direct conversation."
>

  <section class="page-header">
    <div class="container">
      <span class="section__label">{isLabs ? 'PECH Labs · Early Access' : 'Get in Touch'}</span>
      <h1>{isLabs ? 'Request early access<br/>to PECH Labs.' : 'Let\'s talk.'}</h1>
      <p class="page-header__sub">
        {isLabs
          ? 'We\'re onboarding a limited number of early clients. Tell us about your situation and we\'ll be in touch.'
          : 'We work with a select number of clients at a time. If there\'s a fit, we\'ll know quickly.'}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">

      <!-- Form -->
      <div class="contact-form-wrap">
        <form
          action="https://formspree.io/f/REPLACE_WITH_FORMSPREE_ID"
          method="POST"
          class="contact-form"
          aria-label="Contact form"
          novalidate
        >
          {isLabs && <input type="hidden" name="inquiry_type" value="PECH Labs Early Access" />}

          <div class="form-row">
            <div class="form-field">
              <label for="name">Full Name <span aria-hidden="true">*</span></label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name" />
            </div>
            <div class="form-field">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" autocomplete="organization" placeholder="Your company" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@company.com" />
            </div>
            <div class="form-field">
              <label for="phone">Phone / WhatsApp</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+1 (xxx) xxx-xxxx" />
            </div>
          </div>

          <div class="form-field">
            <label for="topic">Topic</label>
            <select id="topic" name="topic">
              <option value="">Select a topic...</option>
              <option value="Fractional Executive Leadership">Fractional Executive Leadership</option>
              <option value="US–Mexico Trade & Nearshoring">US–Mexico Trade &amp; Nearshoring</option>
              <option value="Startup & Venture Advisory">Startup &amp; Venture Advisory</option>
              <option value="E-commerce Strategy">E-commerce Strategy</option>
              <option value="Technology & AI Ventures">Technology &amp; AI Ventures</option>
              <option value="PECH Labs Early Access" selected={isLabs}>PECH Labs — Early Access</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="form-field">
            <label for="message">Tell us about your situation <span aria-hidden="true">*</span></label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder={isLabs
                ? 'What workflows are you looking to automate? What does your team spend too much time on?'
                : 'What are you working on? What does your company need right now?'}
            ></textarea>
          </div>

          <div class="form-field form-field--checkbox">
            <label class="checkbox-label">
              <input type="checkbox" name="consent" required />
              <span>
                I agree to Pech Group's
                <a href="/privacy" target="_blank">Privacy Policy</a>.
                My information will only be used to respond to this inquiry.
              </span>
            </label>
          </div>

          <button type="submit" class="btn btn--primary form-submit">Send Message</button>
        </form>
      </div>

      <!-- Sidebar -->
      <div class="contact-sidebar">
        <div class="contact-info">
          <h3>Where we operate</h3>
          <ul class="location-list">
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <strong>San Francisco Bay Area</strong>
                <span>California, USA</span>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <strong>Texas</strong>
                <span>USA</span>
              </div>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <strong>Mexico</strong>
                <span>Operational footprint across MX</span>
              </div>
            </li>
          </ul>
        </div>

        <div class="contact-info">
          <h3>Email us directly</h3>
          <a href="mailto:pech@pechgroup.com" class="contact-email">pech@pechgroup.com</a>
        </div>

        <!-- WhatsApp link removed: it used a placeholder number (wa.me/1XXXXXXXXXX) and showed an
             internal "update DECISIONS.md" note to visitors. [TODO: Ed — WhatsApp number] -->

        <div class="contact-info contact-response">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <p>We typically respond within one business day.</p>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    background: var(--navy);
    padding: 7rem 0 5rem;
  }
  .page-header h1 { color: var(--white); margin: 0.5rem 0 1rem; }
  .page-header__sub {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.65);
    max-width: 52ch;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .form-field label {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navy);
  }
  .form-field label span { color: var(--gold-dark); }
  .form-field input,
  .form-field select,
  .form-field textarea {
    min-height: var(--tap);
    padding: 0.75rem 1rem;
    border: 1.5px solid rgba(1,8,45,0.45);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--navy);
    background: var(--white);
    transition: border-color var(--transition);
    width: 100%;
  }
  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(202,173,135,0.15);
  }
  .form-field textarea { resize: vertical; min-height: 130px; }
  .form-field select { appearance: none; cursor: pointer; }

  .form-field--checkbox { flex-direction: row; gap: 0; }
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-family: var(--font-body) !important;
    font-weight: 400 !important;
    font-size: 0.875rem;
    color: var(--slate);
    line-height: 1.5;
  }
  .checkbox-label input { width: auto; margin-top: 2px; flex-shrink: 0; }
  .checkbox-label a { color: var(--gold-dark); text-decoration: underline; }

  .form-submit { align-self: flex-start; }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    position: sticky;
    top: 100px;
  }
  .contact-info h3 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-dark);
    margin-bottom: 1rem;
  }

  .location-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .location-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .location-list svg {
    width: 16px; height: 16px;
    stroke: var(--gold);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .location-list strong {
    display: block;
    font-size: 0.9rem;
    color: var(--navy);
  }
  .location-list span {
    font-size: 0.8rem;
    color: var(--slate);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    transition: color var(--transition);
  }
  .contact-email:hover { color: var(--gold-dark); }

  .whatsapp-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.25rem;
    background: #25D366;
    color: white;
    border-radius: var(--radius);
    font-family: var(--font-head);
    font-size: 0.875rem;
    font-weight: 600;
    transition: all var(--transition);
    text-decoration: none;
  }
  .whatsapp-link:hover { background: #1da851; transform: translateY(-2px); }
  .whatsapp-link svg { width: 18px; height: 18px; fill: white; flex-shrink: 0; }
  .whatsapp-note {
    font-size: 0.75rem;
    color: var(--slate-light);
    margin-top: 0.5rem;
    font-style: italic;
    max-width: none;
  }

  .contact-response {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--off-white);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  .contact-response svg {
    width: 18px; height: 18px;
    stroke: var(--gold-dark);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    flex-shrink: 0;
  }
  .contact-response p {
    font-size: 0.875rem;
    color: var(--slate);
    margin: 0;
    max-width: none;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
    .contact-sidebar { position: static; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
