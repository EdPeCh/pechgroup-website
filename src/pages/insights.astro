---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Insights"
  description="Perspectives on executive leadership, US–Mexico strategy, nearshoring, and applied AI from the team at Pech Group."
>

  <section class="page-header">
    <div class="container">
      <span class="section__label">Insights</span>
      <h1>Perspectives from<br/><span style="color:var(--gold)">the field.</span></h1>
      <p class="page-header__sub">
        We write about what we actually do — executive leadership, cross-border
        strategy, and the emerging frontier of applied AI in business operations.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="insights-empty">
        <div class="insights-empty__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <h2>Content coming soon.</h2>
        <p>
          We're building this section as an ongoing record of what we learn
          in the field. Check back — the first pieces are in progress.
        </p>
        <p>
          Topics we'll cover: fractional executive leadership, US–Mexico market
          dynamics, nearshoring strategy, autonomous AI agents, and the
          operating systems of high-growth companies.
        </p>
        <a href="/contact" class="btn btn--outline-dark" style="margin-top:1.5rem;">
          Get notified when we publish
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    background: var(--navy);
    padding: 7rem 0 5rem;
  }
  .page-header h1 { color: var(--white); margin: 0.5rem 0 1rem; }
  .page-header__sub {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.65);
    max-width: 52ch;
  }

  .insights-empty {
    max-width: 560px;
    padding: 3rem 0;
  }
  .insights-empty__icon {
    width: 56px; height: 56px;
    background: rgba(202,173,135,0.1);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  .insights-empty__icon svg {
    width: 24px; height: 24px;
    stroke: var(--gold);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .insights-empty h2 { margin-bottom: 1rem; }
  .insights-empty p { margin-bottom: 0.75rem; }
</style>
