---
import { ui, CONTACT_EMAIL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  switchHref: string;
}
const { lang, switchHref } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const p = Astro.url.pathname;
const home = lang === 'en' ? '/' : '/es/';
const isOn = (href: string) => !href.includes('#') && p.startsWith(href);
---

<header class="hdr" id="hdr">
  <div class="wrap hdr__inner">

    <a href={home} class="hdr__logo" aria-label={t.homeLabel}>
      <svg viewBox="0 0 60 54" aria-hidden="true" class="hdr__diamond">
        <polygon points="30,2 58,18 46,52 14,52 2,18" />
        <line x1="2"  y1="18" x2="58" y2="18"/>
        <line x1="30" y1="2"  x2="14" y2="52"/>
        <line x1="30" y1="2"  x2="46" y2="52"/>
        <line x1="14" y1="52" x2="30" y2="18"/>
        <line x1="46" y1="52" x2="30" y2="18"/>
      </svg>
      <div class="hdr__wordmark">
        <span class="hdr__pech">PECH</span>
        <span class="hdr__sub">{t.tagline}</span>
      </div>
    </a>

    <nav class="hdr__nav" aria-label={t.navLabel}>
      {t.nav.map(l => (
        <a
          href={l.href}
          hreflang={'hreflang' in l ? l.hreflang : undefined}
          class:list={['hdr__link', { 'hdr__link--on': isOn(l.href) }]}
          aria-current={isOn(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <a href={switchHref} class="lang-sw" hreflang={other} lang={other}>
        {t.langSwitch.otherShort}<span class="sr-only"> — {t.langSwitch.other}</span>
      </a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-teal">{t.contact}</a>
    </nav>

    <div class="hdr__mob-actions">
      <a href={switchHref} class="lang-sw" hreflang={other} lang={other}>
        {t.langSwitch.otherShort}<span class="sr-only"> — {t.langSwitch.other}</span>
      </a>
      <button
        class="hdr__burger"
        type="button"
        aria-label={t.menuOpen}
        aria-expanded="false"
        aria-controls="mob-nav"
        data-open-label={t.menuOpen}
        data-close-label={t.menuClose}
      >
        <span/><span/><span/>
      </button>
    </div>
  </div>

  <nav class="mob-nav" id="mob-nav" aria-label={t.navLabel} hidden>
    {t.nav.map(l => (
      <a
        href={l.href}
        hreflang={'hreflang' in l ? l.hreflang : undefined}
        class="mob-nav__link"
        aria-current={isOn(l.href) ? 'page' : undefined}
      >{l.label}</a>
    ))}
    <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-teal mob-nav__cta">{t.contact}</a>
  </nav>
</header>

<style>
.hdr {
  position:sticky; top:0; z-index:100;
  background:rgba(13,13,13,0.97);
  backdrop-filter:blur(10px);
  border-bottom:1px solid rgba(90,191,181,0.1);
}
.hdr--shadow { box-shadow:0 2px 20px rgba(0,0,0,0.5); }

.hdr__inner {
  display:flex; align-items:center; justify-content:space-between;
  height:64px; gap:1rem;
}

/* Logo */
.hdr__logo {
  display:flex; align-items:center; gap:0.75rem;
  min-height:var(--tap);
  text-decoration:none; flex-shrink:0;
}
.hdr__diamond {
  width:28px; height:28px; flex-shrink:0;
  stroke:var(--teal); fill:none;
  stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round;
}
.hdr__wordmark { display:flex; flex-direction:column; line-height:1; }
.hdr__pech {
  font-family:var(--font-h);
  font-size:1.15rem; font-weight:700;
  letter-spacing:0.18em;
  color:var(--white);
}
.hdr__sub {
  font-family:var(--font-h);
  font-size:0.58rem; font-weight:300;
  letter-spacing:0.2em;
  text-transform:uppercase;
  color:var(--teal);
  margin-top:2px;
}

/* Nav links */
.hdr__nav { display:flex; align-items:center; gap:1.25rem; }
.hdr__link {
  display:inline-flex; align-items:center; min-height:var(--tap);
  font-family:var(--font-h);
  font-size:0.7rem; font-weight:400;
  letter-spacing:0.14em; text-transform:uppercase;
  color:rgba(255,255,255,0.7);
  transition:color var(--ease); position:relative;
}
.hdr__link::after {
  content:''; position:absolute; bottom:8px; left:0;
  width:0; height:1px; background:var(--teal);
  transition:width var(--ease);
}
.hdr__link:hover, .hdr__link--on { color:var(--white); }
.hdr__link:hover::after, .hdr__link--on::after { width:100%; }

/* Language switch */
.lang-sw {
  display:inline-flex; align-items:center; justify-content:center;
  min-width:var(--tap); min-height:var(--tap);
  font-family:var(--font-h); font-size:0.7rem; letter-spacing:0.14em;
  color:var(--teal);
  border:1px solid rgba(90,191,181,0.4); border-radius:var(--radius);
  transition:border-color var(--ease), color var(--ease);
}
.lang-sw:hover { border-color:var(--teal); color:var(--white); }

/* Burger */
.hdr__mob-actions { display:none; align-items:center; gap:0.5rem; }
.hdr__burger {
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px;
  width:var(--tap); height:var(--tap);
  background:none; border:none; cursor:pointer; padding:0;
}
.hdr__burger span {
  display:block; width:22px; height:1.5px;
  background:var(--white); border-radius:1px; transition:all 0.3s;
}

/* Mobile nav */
.mob-nav {
  display:flex; flex-direction:column;
  background:var(--black);
  border-top:1px solid rgba(90,191,181,0.08);
  padding:1.25rem 1.5rem 1.75rem;
}
.mob-nav[hidden] { display:none; }
.mob-nav__link {
  display:flex; align-items:center; min-height:var(--tap);
  font-family:var(--font-h);
  font-size:0.75rem; letter-spacing:0.16em; text-transform:uppercase;
  color:rgba(255,255,255,0.75);
  border-bottom:1px solid rgba(255,255,255,0.05);
  transition:color var(--ease);
}
.mob-nav__link:hover { color:var(--teal); }
.mob-nav__cta { margin-top:1.25rem; }

@media(max-width:1100px) {
  .hdr__nav { display:none; }
  .hdr__mob-actions { display:flex; }
}
</style>

<script>
const hdr    = document.getElementById('hdr');
const burger = document.querySelector<HTMLButtonElement>('.hdr__burger');
const mob    = document.getElementById('mob-nav');

window.addEventListener('scroll', () => hdr?.classList.toggle('hdr--shadow', scrollY > 10), { passive: true });

function setOpen(open: boolean) {
  if (!mob || !burger) return;
  mob.toggleAttribute('hidden', !open);
  burger.setAttribute('aria-expanded', String(open));
  burger.setAttribute('aria-label', (open ? burger.dataset.closeLabel : burger.dataset.openLabel) ?? '');
}

burger?.addEventListener('click', () => setOpen(mob?.hasAttribute('hidden') ?? false));
mob?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && mob && !mob.hasAttribute('hidden')) { setOpen(false); burger?.focus(); }
});
</script>
